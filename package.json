{
  "name": "@0xkahi/cli-dye",
  "version": "1.1.1",
  "private": false,
  "description": "fast nodejs cli library for formatting terminal text",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "author": "0xKahi",
  "keywords": [
    "ansi",
    "cli",
    "color",
    "colors",
    "console",
    "terminal"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xKahi/cli-dye.git"
  },
  "scripts": {
    "biome": "biome check ./src ./test",
    "lint": "bun biome",
    "lint:fix": "bun biome --write",
    "test": "bun test",
    "type-check": "tsc --noEmit",
    "check": "bun run lint && bun run type-check",
    "build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --target node && tsc --project tsconfig.build.json",
    "changeset": "changeset",
    "release": "changeset publish",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/cli": "^3",
    "@types/bun": "latest",
    "@types/node": "^24.0.0",
    "bun-types": "latest",
    "typescript": "^7"
  }
}
